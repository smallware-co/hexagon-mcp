# Hexagon MCP — credential template
# Copy this file to .env and fill in your own values.
# Nothing in this repo stores or transmits these anywhere but your own machine
# and the APIs you're authenticating against.

# --- Google OAuth (shared by GSC, GA4, and AdSense) ---
# From a Google Cloud project with Search Console API, Analytics Data API,
# and AdSense Management API enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Search Console ---
# The property exactly as it appears in Search Console, e.g. sc-domain:example.com
GSC_SITE_URL=

# --- GA4 ---
# Numeric GA4 property ID, found in GA4 Admin > Property Settings
GA4_PROPERTY_ID=

# --- AdSense ---
# Your AdSense publisher ID, format pub-XXXXXXXXXXXXXXXX
ADSENSE_PUBLISHER_ID=

# --- Google Ads API (Keyword Planner) ---
# Requires a developer token approved for at least Basic Access.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# --- Reddit ---
# From a Reddit "script" type app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=hexagon-mcp/0.1.0
